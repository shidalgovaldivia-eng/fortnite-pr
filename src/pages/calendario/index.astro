---
/**
 * Calendario: las sesiones que TODAVIA no se jugaron, sacadas del descubrimiento del sitio de Epic.
 *
 * Antes el boton "Ver calendario completo" apuntaba a un ancla de la portada (#campeonatos), que
 * ademas activaba el overlay de carga y dejaba la pagina tapada. Ahora es una pagina de verdad, y
 * solo lista lo que no se jugo: si ya tenemos sus standings, la sesion se cae de la lista.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { sesionesFuturas, bonita, modoDe, formatoDe, imagenDe, IMAGENES_GENERICAS, resumen } from '../../lib/datos';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const num = (x: number) => x.toLocaleString('es-CL');

const porDia = new Map<string, typeof sesionesFuturas>();
for (const s of sesionesFuturas) {
  const dia = new Date(s.fecha).toLocaleDateString('es-CL', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
  const lista = porDia.get(dia) ?? [];
  lista.push(s);
  porDia.set(dia, lista);
}

const cuando = (s: (typeof sesionesFuturas)[number]) =>
  s.enHoras < 24
    ? s.enHoras <= 1
      ? 'en menos de 1 hora'
      : `en ${num(s.enHoras)} horas`
    : `en ${num(s.enDias)} día${s.enDias === 1 ? '' : 's'}`;
---

<BaseLayout title="Calendario · ALTURA" description={`${sesionesFuturas.length} sesiones por jugar en el calendario competitivo de Fortnite, por región y serie.`}>
  <div class="page-shell">
    <Header />

    <main>
      <nav class="migas" aria-label="Ruta">
        <a href={base}>Inicio</a>
        <i class="ph ph-caret-right"></i>
        <span>Calendario</span>
      </nav>

      <section class="cabecera">
        <span class="eyebrow">Lo que viene</span>
        <h1>Calendario</h1>
        <p class="etiqueta">
          {num(sesionesFuturas.length)} sesiones por jugar, de {resumen.series.length} series y
          {resumen.regiones.length} regiones, según el calendario del sitio oficial de Epic.
          <b>Las que ya se jugaron no aparecen acá</b>: para eso están
          <a href={`${base}torneos/`}>las tablas de resultados</a>.
        </p>
      </section>

      <div class="dias">
        {[...porDia.entries()].map(([dia, sesiones]) => (
          <section class="dia">
            <header class="dia-cabecera">
              <h2>{dia}</h2>
              <span class="cuenta">{sesiones.length} sesión{sesiones.length === 1 ? '' : 'es'}</span>
            </header>
            <ul>
              {sesiones.map((s) => (
                <li class="sesion">
                  <img src={`${base}assets/${imagenDe(s.serie) || IMAGENES_GENERICAS[0]}`} alt="" loading="lazy" />
                  <div class="sesion-copia">
                    <b>{bonita(s.serie)} <span class="region">{s.region}</span></b>
                    <small>{modoDe(s.serie)} · {formatoDe(s.serie)} · {s.etiqueta.replace(/\s*\d+\/\d+\/\d+.*$/, '') || 'Sesión'}</small>
                  </div>
                  <div class="sesion-hora">
                    <strong>{new Date(s.fecha).toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit' })}</strong>
                    <small>{cuando(s)}</small>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </main>

    <footer class="site-footer">
      <b>ALTURA</b>
      <span>Calendario descubierto en fortnite.com/competitive. Las tablas de lo ya jugado se recolectan aparte.</span>
    </footer>
  </div>

  <style is:global>
    .migas { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 13px; margin: 18px 0 6px; }
    .migas a { color: var(--muted); text-decoration: none; }
    .cabecera h1 { font-family: var(--font-display); font-size: clamp(26px, 4vw, 44px); margin: 6px 0 4px; }
    .etiqueta { color: var(--muted); max-width: 78ch; font-size: 13.5px; }
    .etiqueta a { color: var(--blue); }
    .dias { display: grid; gap: 14px; margin: 18px 0 30px; }
    .dia { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; }
    .dia-cabecera { display: flex; align-items: baseline; gap: 10px; margin-bottom: 8px; }
    .dia-cabecera h2 { font-family: var(--font-display); font-size: 20px; margin: 0; text-transform: capitalize; }
    .cuenta { color: var(--muted); font-size: 12px; }
    .dia ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
    .sesion { display: flex; align-items: center; gap: 12px; padding: 8px 6px; border-bottom: 1px solid #12203a; }
    .sesion:last-child { border-bottom: none; }
    .sesion img { width: 62px; height: 40px; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); flex: 0 0 auto; }
    .sesion-copia { flex: 1 1 auto; min-width: 0; }
    .sesion-copia b { display: block; font-size: 14.5px; }
    .sesion-copia small { color: var(--muted); font-size: 12px; }
    .region { font-size: 10px; color: var(--blue); border: 1px solid var(--line); border-radius: 999px; padding: 1px 7px; margin-left: 4px; }
    .sesion-hora { text-align: right; flex: 0 0 auto; }
    .sesion-hora strong { font-family: var(--font-display); font-size: 17px; display: block; }
    .sesion-hora small { color: var(--muted); font-size: 11.5px; }
  </style>
</BaseLayout>
