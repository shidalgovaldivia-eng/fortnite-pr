---
import { resumen } from '../lib/datos';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const actualizado = new Date(resumen.generado).toLocaleString('es-CL', {
  day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
});
---
<header class="site-header">
  <a class="brand" href={base} aria-label="Altura, inicio">
    <span class="brand__mark" aria-hidden="true">A</span>
    <span>ALTURA</span>
  </a>
  <nav aria-label="Navegación principal">
    <a class="is-active" href={`${base}torneos/`}>Torneos</a>
    <a href={`${base}jugadores/`}>Clasificación</a>
    <a href={`${base}jugadores/`}>Jugadores</a>
  </nav>
  <form class="global-search" id="buscar" role="search" action={`${base}torneos/`}>
    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
    <input type="search" name="q" aria-label="Buscar torneos" placeholder="Buscar torneos, jugadores o regiones…" />
    <kbd>/</kbd>
  </form>
  <div class="freshness"><span></span><div>Actualizado {actualizado}<small>{resumen.rondas} rondas · {resumen.fichasDeJugador} fichas de jugador</small></div></div>
</header>
