---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@phosphor-icons/web/regular';
import '../styles/global.css';

const { title = 'ALTURA · Fortnite competitivo', description = 'Torneos, resultados y rankings competitivos de Fortnite.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050914" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <div class="route-loader" aria-hidden="true">
      <div class="route-loader__mark">A</div>
      <span>Cargando competición</span>
    </div>
    <script is:inline>
      const loader = document.querySelector('.route-loader');
      document.addEventListener('click', (event) => {
        const link = event.target.closest('a[href]');
        if (!link || event.metaKey || event.ctrlKey || link.target === '_blank') return;
        const url = new URL(link.href, location.href);
        // OJO: un enlace ANCLA (#campeonatos) NO navega, asi que el loader quedaría encendido para
        // siempre y tapaba la pagina ("se pega" al pulsar Ver calendario completo"). Solo se activa
        // cuando cambia de verdad la ruta o los parametros.
        const mismaPagina = url.origin === location.origin && url.pathname === location.pathname && url.search === location.search;
        if (url.origin === location.origin && !mismaPagina) loader?.classList.add('is-active');
      });
      window.addEventListener('pageshow', () => loader?.classList.remove('is-active'));
      window.addEventListener('hashchange', () => loader?.classList.remove('is-active'));
    </script>
  </body>
</html>
